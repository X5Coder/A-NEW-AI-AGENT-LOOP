# Runtime data - models (large binary assets)
project/models/embedding/*
project/models/vision/*
project/models/tts/*
project/models/stt/*
# Keep structure but ignore contents
!project/models/embedding/.gitkeep
!project/models/embedding/service.py
!project/models/vision/.gitkeep
!project/models/vision/service.py
!project/models/tts/.gitkeep
!project/models/stt/.gitkeep

# Alternative: ignore all model binaries everywhere
**/models/**/ *.safetensors
**/models/**/ *.bin
**/models/**/ *.onnx
**/models/**/ *.pt

# X5Agent runtime sandbox - never commit user data / workspace
X5Agent/Data/
X5Agent/Workspace/
!X5Agent/.gitkeep

# Secrets - never commit provider keys saved from the console UI
project/storage/database/model_providers.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs & temp
*.log
tmp/

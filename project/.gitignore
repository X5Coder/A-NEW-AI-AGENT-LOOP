# === Built-in embedding resources - NEVER commit to git (large binaries) ===
/embedding_model/*
!/embedding_model/.gitkeep

# Fallback: ignore any model weights if accidentally placed outside
**/*.safetensors
**/*.bin
**/*.onnx
**/*.pt
**/*.ct2
**/*.engine

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.env
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Studio shell build inputs only (dist/ IS committed: the console serves it)
web/studio-pdf/node_modules/
web/studio-pdf/dist-ssr/

# Logs / temp / storage runtime data
*.log
storage/database/*
!storage/database/.gitkeep
storage/vector/*
!storage/vector/.gitkeep
!storage/vector/*.seed.json
storage/files/*
!storage/files/.gitkeep
!storage/files/images/.gitkeep
tmp/

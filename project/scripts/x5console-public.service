# x5console-public.service — X5Agent console + Tailscale Funnel public link.
# Install:
#   sudo cp x5console-public.service /etc/systemd/system/
#   # edit User + WorkingDirectory below to match your machine, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now x5console-public
#   systemctl status x5console-public
# Requires: tailscale installed + logged in on the host.
[Unit]
Description=X5Agent console (public via Tailscale Funnel, 127.0.0.1:7777)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# --- EDIT THESE TWO LINES ---
User=ubuntu
WorkingDirectory=/opt/X5Agent/project
# ----------------------------
ExecStart=/usr/bin/python3 -m web.server.server --host 127.0.0.1 --port 7777 --public
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

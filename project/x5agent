#!/usr/bin/env bash
# X5Agent starter — run from the project/ directory, no update check:
#   ./x5agent start              start the console on 0.0.0.0:7777
#   ./x5agent start --public     also enable the Tailscale Funnel public link
# (For install + update + start in one step use the one-liner instead:
#  curl -fsSL https://raw.githubusercontent.com/X5Coder/X5Agent/main/setup.sh | bash)
set -euo pipefail
cd "$(dirname "$0")"

PY=""
for cand in python3.12 python3 python; do
  if command -v "$cand" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "[x5agent] ERROR: no python found" >&2
  exit 1
fi

if [ "${1:-}" = "start" ]; then
  shift
  exec "$PY" -m web.server.server --host 0.0.0.0 --port 7777 "$@"
fi
echo "usage: ./x5agent start [--public]" >&2
exit 1
